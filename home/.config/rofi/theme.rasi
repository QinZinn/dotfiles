* {
    bg: #2E3440F5;
    bg-alt: #3B4252F5;
    surface: #434C5EF2;
    fg: #D8DEE9FF;
    fg-muted: #D8DEE9B8;
    accent: #88C0D0FF;
    accent-strong: #81A1C1FF;
    border: #88C0D05C;
    background-color: transparent;
    text-color: @fg;
    spacing: 0;
}

window {
    location: center;
    anchor: center;
    width: 640px;
    border: 1px;
    border-color: @border;
    border-radius: 18px;
    background-color: @bg;
    padding: 24px;
}

mainbox {
    children: [ inputbar, listview, message ];
    spacing: 16px;
    background-color: transparent;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @bg-alt;
    border: 1px;
    border-color: #4C566A99;
    border-radius: 12px;
    padding: 12px 16px;
    spacing: 12px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search applications";
    placeholder-color: @fg-muted;
    text-color: @fg;
}

listview {
    columns: 1;
    lines: 8;
    fixed-height: true;
    cycle: true;
    scrollbar: false;
    spacing: 6px;
}

element {
    orientation: horizontal;
    border-radius: 10px;
    padding: 10px 12px;
    spacing: 12px;
}

element normal {
    background-color: transparent;
    text-color: @fg-muted;
}

element alternate {
    background-color: transparent;
    text-color: @fg-muted;
}

element selected {
    background-color: @accent;
    text-color: #2E3440FF;
}

element-icon {
    size: 1.35em;
    background-color: transparent;
    text-color: inherit;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}

message {
    background-color: transparent;
    text-color: @fg-muted;
}
