#!/usr/bin/env bash
set -u

wallpaper_dir="$HOME/Pictures/wallpapers"

notify_error() {
    notify-send -u critical "Wallpaper" "$1" 2>/dev/null || true
    printf 'Wallpaper: %s\n' "$1" >&2
}

if [[ ! -d "$wallpaper_dir" ]]; then
    notify_error "No wallpaper directory: $wallpaper_dir"
    exit 1
fi

images=()
shopt -s nullglob
for image in "$wallpaper_dir"/*; do
    [[ -f "$image" ]] || continue
    case "${image,,}" in
        *.jpg|*.jpeg|*.png|*.webp|*.gif|*.avif)
            images+=("$image")
            ;;
    esac
done

if (( ${#images[@]} == 0 )); then
    notify_error "Add a JPG, PNG, WEBP, GIF or AVIF image to $wallpaper_dir"
    exit 1
fi

selected="$(printf '%s\n' "${images[@]##*/}" | rofi -dmenu -config "$HOME/.config/rofi/config.rasi" -p 'Wallpaper' || true)"
[[ -n "$selected" ]] || exit 0

target="$wallpaper_dir/$selected"
found=0
for img in "${images[@]}"; do
    if [[ "$img" == "$target" ]]; then
        found=1
        break
    fi
done
(( found )) || exit 0

if ! awww query >/dev/null 2>&1; then
    awww-daemon >/dev/null 2>&1 &
    for _ in {1..20}; do
        awww query >/dev/null 2>&1 && break
        sleep 0.1
    done
fi

awww img "$target" \
    --transition-type grow \
    --transition-pos center \
    --transition-fps 60 \
    --transition-duration 1.2 \
    --transition-bezier '0.20,0.80,0.20,1.00'

notify-send -t 1800 "Wallpaper" "$selected" 2>/dev/null || true
